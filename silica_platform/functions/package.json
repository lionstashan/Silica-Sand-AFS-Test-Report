{
  "name": "silica-functions",
  "private": true,
  "version": "0.1.0",
  "engines": { "node": ">=18" },
  "scripts": {
    "build": "tsc -p .",
    "lint": "eslint src --ext .ts",
    "serve": "firebase --config ../infra/firebase.json emulators:start --only functions,firestore,auth,storage",
    "deploy": "firebase deploy --only functions",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:unit": "jest --config jest.config.js --runInBand",
    "test:rules": "node test/rulesTestRunner.js",
    "roles:set": "ts-node scripts/set-roles.ts",
    "seed": "ts-node scripts/seed.ts",
    "users:list": "ts-node scripts/list-users.ts"
  },
  "dependencies": {
    "firebase-admin": "^12.5.0",
    "firebase-functions": "^4.9.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "ts-node": "^10.9.2",
    "eslint": "^8.57.0",
    "@typescript-eslint/parser": "^7.0.1",
    "@typescript-eslint/eslint-plugin": "^7.0.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "@types/jest": "^29.5.11",
    "@firebase/rules-unit-testing": "^2.0.7"
  }
}
