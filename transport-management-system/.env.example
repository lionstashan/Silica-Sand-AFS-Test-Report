DATABASE_URL=postgres://username:password@localhost:5432/transport_db
CUSTOMER_TOKEN_SECRET=replace-with-strong-random-secret
EXPENSE_TOKEN_SECRET=replace-with-strong-random-secret
TRANSPORT_TOKEN_SECRET=replace-with-strong-random-secret
CUSTOMER_TOKEN_TTL_SECONDS=604800
EXPENSE_TOKEN_TTL_SECONDS=604800
TRANSPORT_TOKEN_TTL_SECONDS=86400
ENABLE_USER_AUTH_V2=false
ENABLE_ADMIN_PANEL_V2=false

# Transport role PINs (required in production; defaults are blocked in production startup validation)
ROLE_PIN_GATE=
ROLE_PIN_WEIGHBRIDGE=
ROLE_PIN_DISPATCH=
ROLE_PIN_LOADING=
ROLE_PIN_ACCOUNTS=
ROLE_PIN_MANAGER=
ROLE_PIN_ADMIN=

BCRYPT_COST=10
